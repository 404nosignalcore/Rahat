{
  "name": "rahat",
  "version": "1.0.0",
  "description": "Rahat - AI-Powered Women's Personal Safety & Community Mobile Application",
  "main": "index.js",
  "scripts": {
    "predev": "node scripts/free-port.js",
    "dev": "expo start --port 8081 --lan",
    "pretunnel": "node scripts/free-port.js",
    "tunnel": "expo start --port 8081 --tunnel ngrok",
    "prestart": "node scripts/free-port.js",
    "start": "expo start --port 8081 --lan",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "server": "node server.js",
    "test": "jest --watchAll=false",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "expo": "~58.0.25",
    "expo-constants": "~58.0.16",
    "expo-haptics": "~58.0.8",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-location": "~58.0.22",
    "expo-notifications": "~58.1.9",
    "expo-sensors": "~58.0.5",
    "expo-sms": "~58.0.3",
    "expo-status-bar": "~58.0.5",
    "firebase": "^10.14.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/ngrok": "^4.1.3",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "jest": "~30.5.2",
    "typescript": "~6.0.3"
  },
  "private": true
}
