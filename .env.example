# ===================================================
# Rahat (राहत) Environment Configuration
# ===================================================
# Note: In development, if Firebase keys are left blank,
# Rahat automatically activates the Offline / Local Mock Adapter.
# To connect to production Firebase, fill in the values below.

EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Real-Time SOS Webhook Dispatch Endpoint (Optional custom HTTP endpoint / webhook URL)
# By default, Rahat invokes the production Firebase Cloud Function (dispatchSosAlert) when Firebase is configured,
# and activates automatic native device SMS (expo-sms) when offline or unconfigured.
# For local dev server debugging only, uncomment:
# EXPO_PUBLIC_SOS_FUNCTION_URL=http://localhost:3000/api/sos
EXPO_PUBLIC_SOS_FUNCTION_URL=

# Community Rescue Simulation Flag (Set true only for development UI testing)
# WARNING: Keep false or unset in production to prevent simulated helpers
EXPO_PUBLIC_ENABLE_COMMUNITY_SIMULATION=false

# Map & Geolocation API (optional for production Google Maps tile rendering)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_key_here

# App configuration
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_DEFAULT_EMERGENCY_NUMBER=112
