rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles & private settings
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Emergency contacts subcollection
      match /emergency_contacts/{contactId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Safety zones (Public read, admin write)
    match /safety_zones/{zoneId} {
      allow read: if true;
      allow write: if false; // Managed via server-side admin SDK
    }

    // Safety reports (Community reporting)
    match /safety_reports/{reportId} {
      allow read: if true;
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'unverified'; // Community reports start unverified
      allow update: if isAuthenticated() && (
        // Allow upvoting/downvoting
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotes', 'downvotes', 'userVoted']) ||
        // Allow community flagging
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['flagCount', 'status'])
      );
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;

      // Report comments
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
        allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      }
    }

    // Journeys (Strict privacy: Only journey owner can read/write)
    match /journeys/{journeyId} {
      allow read, write: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // Safe Circles
    match /safe_circles/{circleId} {
      allow read: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        request.auth.uid in resource.data.memberIds
      );
      allow write: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
    }

    // Emergency Alerts (SOS)
    match /emergency_alerts/{alertId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow read: if isAuthenticated(); // Accessible by designated contacts receiving alert
    }

    // Verified Help Locations & SafeHeroes Directory
    match /help_locations/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /safe_heroes/{id} {
      allow read: if true;
      allow write: if false;
    }
  }
}

